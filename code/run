#!/usr/bin/env bash
set -ex


mkdir -p "/results/oper_files/"
oppat="/results/oper_files/" 

mkdir -p "/results/oper_files/files/"
operators_tex_files="/results/oper_files/files/" #folder where the new activated files will be written during runtime. After each compilation, the code will delete the generated files by itself (!)... 

mkdir -p "/results/excels/"
newexcel="/results/excels/results.csv" #excel with labels

excelpat="/data/feature_extraction.csv" #original feature extraction without labelling

documents_path="/data/tex_and_pdf_files/" #tex&pdf documents path

folder_of_feature_extraction_pickles="/data/feature_extraction_pickles/"  #path to folder where you saved the pickle object of the results from the feature extraction process

max_number_of_operators=2 #CHANGE: maximal number of operators per each document. This is something we added to codeOcean, so you won't wait for all operators to be activated (long runtime). In the code you need to remove it.

#coppying style elements to this directory
cp /code/style_tex/bibliography.bib $oppat
cp /code/style_tex/aaai22.sty $oppat
cp /code/style_tex/aaai22.bst $oppat
cp /code/style_tex/aaai22.bib $oppat
cp /code/style_tex/visualization.png $oppat
bibpat="/code/style_tex/bibliography.bib" #path to bibliography file

python -u main.py ${excelpat} ${newexcel} ${folder_of_feature_extraction_pickles} ${documents_path} ${operators_tex_files}