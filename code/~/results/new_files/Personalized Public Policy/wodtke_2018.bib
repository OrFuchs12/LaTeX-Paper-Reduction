@article{Fishburn1974SocialChoiceFunction_dsic,
 ISSN = {00361445},
 URL = {http://www.jstor.org/stable/2028762},
 abstract = {With X a family of sets and D a set, a social choice function assigns a nonempty subset F(Y, D) of Y to each (Y, D) âˆˆ X Ã— D. In social choice theory, the sets in X are feasible alternative sets, each D âˆˆ D specifies preferences on the alternatives of individuals in the society, and F(Y, D) denotes the "best" alternatives in Y for each potential situation (Y, D). This paper reviews a number of topics in social choice theory through the medium of social choice functions. It begins with two-alternative situations, providing axiomatic characterizations of simple majority, weighted majority, absolute special majority and representative systems. Various aspects of simple majorities with many alternatives are examined, including facets of cyclical majorities, single-peaked preferences and sets of individual preference orders that guarantee the transitivity of simple majority. A classification of types of conditions for general social choice functions is developed, and relationships among specific types of conditions are explored. The paper concludes with impossibility theorems stemming from the work of Kenneth Arrow. These theorems, which identify sets of logically inconsistent conditions for social choice functions, illustrate some of the conflicts that arise in the ethical foundations of social choice theory.},
 author = {Peter C. Fishburn},
 journal = {SIAM Review},
 number = {1},
 pages = {63--90},
 publisher = {Society for Industrial and Applied Mathematics},
 title = {Social Choice Functions},
 volume = {16},
 year = {1974}
}

