
#!/usr/bin/env bash
set -ex

mkdir -p "code/~/results/helper_files/"
helper_directory="code/~/results/helper_files/" 

mkdir -p "code/~/results/helper_files/files/"
helper_directory_files="code/~/results/helper_files/files/" #folder where the new activated files will be written during runtime

mkdir -p "code/~/results/excels/"
path_for_write_csv="code/~/results/excels/results.csv" #excel with labels

documents_path="data/tex_and_pdf_files/" #tex&pdf documents path

max_number_of_operators=2 #CHANGE: maximal number of operators per each document. This is something we added to codeOcean, so you won't wait for all operators to be activated (long runtime). In the code you need to remove it.

#coppying style elements to this directory
cp code/style_tex/bibliography.bib $helper_directory
cp code/style_tex/aaai22.sty $helper_directory
cp code/style_tex/aaai22.bst $helper_directory
cp code/style_tex/aaai22.bib $helper_directory
cp code/style_tex/visualization.png $helper_directory
bibpat="code/style_tex/bibliography.bib" #path to bibliography file

filename='51500_1' #name of file
type_of_experiment=1 #type of experiment from 0 to 7 (include 7). See README file
path_to_catboost="data/regression_models"
path_to_xgboost="data/classification_models"

python -u code/main.py ${filename} 7 ${max_number_of_operators} ${documents_path} ${path_for_write_csv} ${helper_directory_files} ${bibpat} ${path_to_catboost} ${path_to_xgboost}
